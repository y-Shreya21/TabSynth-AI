# TabSynth AI Environment Configuration
# Copy this file to .env and customize as needed

# Runtime & Hardware
TABSYNTH_ENV=development
LOG_LEVEL=INFO
TABSYNTH_DEVICE=auto          # 'auto', 'mps', 'cuda', or 'cpu'
RANDOM_SEED=42

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
TABSYNTH_API_URL=http://127.0.0.1:8000

# Dashboard Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Storage & Persistence
TABSYNTH_DATA_DIR=data
TABSYNTH_RAW_DIR=data/raw
TABSYNTH_SYNTHETIC_DIR=data/synthetic
TABSYNTH_CHECKPOINT_DIR=checkpoints
TABSYNTH_EXPERIMENT_DIR=experiments/results
TABSYNTH_DB_PATH=data/tabsynth.db

# Concurrency & Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800   # 50MB
MAX_CONCURRENT_JOBS=1

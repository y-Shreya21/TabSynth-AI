# ==============================================================================
# TabSynth Analytics - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target deployment.
# Never commit the .env file containing production secrets to version control.

# --- Application & Runtime Environment ---
TABSYNTH_ENV=development              # Options: 'development', 'staging', 'production'
LOG_LEVEL=INFO                         # Options: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
TABSYNTH_DEVICE=auto                   # Options: 'auto', 'mps' (macOS), 'cuda' (Linux/Windows), 'cpu'
RANDOM_SEED=42                         # Global deterministic seed

# --- FastAPI REST Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                          # Number of Uvicorn worker processes
TABSYNTH_API_URL=http://127.0.0.1:8000

# --- Streamlit Analytics Dashboard ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# --- Storage & Artifact Persistence ---
TABSYNTH_DATA_DIR=data
TABSYNTH_RAW_DIR=data/raw
TABSYNTH_SYNTHETIC_DIR=data/synthetic
TABSYNTH_CHECKPOINT_DIR=checkpoints
TABSYNTH_EXPERIMENT_DIR=experiments/results
TABSYNTH_BACKUP_DIR=backups
TABSYNTH_DB_PATH=data/tabsynth.db

# --- Security & Traffic Controls ---
# Maximum uploaded dataset size in bytes (Default: 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Permitted CORS origins (comma-separated or JSON array)
# In production, do NOT use '*' - list specific origins
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Background Worker & Job Execution ---
# Maximum concurrent background training/synthesis jobs
MAX_CONCURRENT_JOBS=1

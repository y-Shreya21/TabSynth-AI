# TabSynth AI Environment Configuration
# Copy this file to .env and customize as needed

# Runtime & Hardware
TABSYNTH_ENV=development
LOG_LEVEL=INFO
DEVICE=auto          # 'auto', 'mps', 'cuda', or 'cpu'
RANDOM_SEED=42

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Dashboard Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Storage & Paths
CHECKPOINT_DIR=checkpoints/
DATA_DIR=data/
ARTIFACTS_DIR=artifacts/

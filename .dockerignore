# Git & SCM
.git/
.gitignore
.github/

# Python Bytecode, Caches & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Agent & IDE Configurations
.agents/
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Data, SQLite & Artifact Volumes (Prevent baking user/test state into images)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-wal
data/*.db-shm
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
artifacts/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Experiment Results & Backups
experiments/logs/*
!experiments/logs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep
backups/
mlruns/
.mlflow/

# Secrets & Environment Files
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
